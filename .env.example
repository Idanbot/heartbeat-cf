CF_WORKER_URL=https://device-heartbeat-monitor.example.workers.dev
HEARTBEAT_TOKEN=replace-with-a-long-random-token
HEARTBEAT_DEVICE_ID=pi4
HEARTBEAT_DEVICE_NAME="Hermes Pi 4"
HEALTHCHECK_URL=https://your-tunnel.example.com/healthz
CLOUDFLARED_SERVICE=cloudflared

# Set Worker secrets with `npx wrangler secret put`, not in wrangler.toml.
# The client only needs HEARTBEAT_TOKEN; keep these off the device:
# STATUS_TOKEN=replace-with-a-different-long-random-token
# TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id
